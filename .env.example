# ==========================================================================
# Atlas AI - environment configuration
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored and must NEVER be committed.
#
# The same file serves local development and the Docker Compose stack. The
# few values that differ are marked PRODUCTION below.
# ==========================================================================

# ---- Application ---------------------------------------------------------
APP_ENV=development           # development | staging | production
APP_NAME="Atlas AI"
DEBUG=true                    # PRODUCTION: false — true leaks internals in errors
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console            # PRODUCTION: json — console is for humans

# ---- API -----------------------------------------------------------------
API_V1_PREFIX=/api/v1
# Comma-separated browser origins allowed to call the API.
# Leave EMPTY under Compose: nginx serves the app and the API on one origin,
# so there is no cross-origin request to allow.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app REFUSES to start in production while this is the default value.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PRODUCTION: true. Requires HTTPS; off locally because localhost is plain
# HTTP and a secure cookie would never be sent. Enforced at startup.
REFRESH_COOKIE_SECURE=false

# Failed sign-ins allowed per window, counted per client IP and per email.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# ---- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_password
POSTGRES_DB=atlas
# `localhost` when running natively. Compose overrides this to the service
# name automatically — no need to change it here.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- LLM -----------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Tokens the model may spend on reasoning it never shows. These are charged
# against the output budget, so a non-zero value here shortens the visible
# answer unless MAX_OUTPUT_TOKENS rises with it.
LLM_THINKING_BUDGET=0
LLM_MAX_OUTPUT_TOKENS=4096

# ---- Retrieval -----------------------------------------------------------
# Resolves follow-ups like "what about its complexity?" into standalone
# queries. Costs one LLM request per rewrite; a local heuristic gates it.
QUERY_REWRITE_ENABLED=true

# Reads text out of images inside documents, and out of scanned pages that
# have no text layer. Character recognition only — it does not describe
# pictures or interpret charts.
#
# Requires the `tesseract-ocr` system binary, which the Docker image installs.
# Running natively without it, OCR reports itself unavailable and documents
# parse exactly as they did before — nothing fails, images are just skipped.
OCR_ENABLED=true
OCR_LANGUAGE=eng
# Ceiling per document. OCR costs seconds per image, so an unbounded deck
# could occupy a worker for a very long time.
OCR_MAX_IMAGES_PER_DOCUMENT=40

# Cross-encoder reranking. Off by default: benchmarking showed it improves
# ranking, costs ~450ms, and slightly reduces recall on the evaluation set.
RERANK_ENABLED=false

# ---- Deployment ----------------------------------------------------------
# Host port the Compose stack publishes the app on.
ATLAS_PORT=8080

# ---- Frontend (Vite: only VITE_* vars reach the browser) -----------------
# Native development only. The Compose build sets this to "/" so the browser
# uses same-origin paths through nginx.
VITE_API_BASE_URL=http://localhost:8000

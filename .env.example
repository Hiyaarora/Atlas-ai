# ==========================================================================
# Atlas AI - environment configuration
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored and must NEVER be committed.
# ==========================================================================

# ---- Application ---------------------------------------------------------
APP_ENV=development           # development | staging | production
APP_NAME="Atlas AI"
DEBUG=true
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console            # console (human-readable) | json (production)

# ---- API -----------------------------------------------------------------
API_V1_PREFIX=/api/v1
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Security -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- PostgreSQL ----------------------------------------------------------
# Running PostgreSQL natively on your machine, this is `localhost`. Under
# Docker Compose it becomes the compose service name (`postgres`).
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_password
POSTGRES_DB=atlas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- LLM providers -------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# ---- Frontend (Vite: only VITE_* vars reach the browser) -----------------
VITE_API_BASE_URL=http://localhost:8000
